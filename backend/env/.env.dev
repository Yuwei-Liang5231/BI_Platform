# 开发环境（默认）
APP_ENV=dev
LOG_LEVEL=DEBUG
DATA_DIR=../data
API_PREFIX=/api
# 阶段 2 起启用；LLM（OpenAI 兼容接口：PwC 共享生成式 AI 服务 / DeepSeek 等）。
# 真实凭据不要写在本文件（本文件进 git）——写入同目录 .env.dev.local（已被 .gitignore 忽略），
# 或运行时在「模型管理」页登记启用（DB 记录优先于 env）。
# 企业内网自签证书网关：LLM_VERIFY_SSL=false 跳过校验，或 LLM_CA_BUNDLE 指向公司 CA 证书包。
# LLM_EXTRA_BODY：JSON 字符串，逐键并入 chat 请求体（如 '{"enable_thinking": false}' 关闭推理模型思考）。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VERIFY_SSL=true
LLM_CA_BUNDLE=
LLM_EXTRA_BODY=
